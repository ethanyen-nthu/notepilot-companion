{
  "name": "notepilot-companion",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.10",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "katex": "^0.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/katex": "^0.16.8",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:plugin && npm run test:gateway",
    "build:ios:bundle": "expo export --platform ios --output-dir dist-ios",
    "build:web": "expo export --platform web",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "check:native": "node scripts/verify-native.cjs",
    "test:plugin": "node scripts/test-plugin.cjs",
    "gateway": "node --env-file-if-exists=.env server/start.mjs",
    "test:gateway": "node --test server/tests/*.test.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
